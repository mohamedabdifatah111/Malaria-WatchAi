```env
DJANGO_SECRET_KEY=replace_with_a_random_secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=malaria_watchai
DB_USER=malaria_app
DB_PASSWORD=your_local_database_password
DB_HOST=localhost
DB_PORT=5432

# Windows only: folder where OSGeo4W (GDAL/GEOS) is installed.
OSGEO4W_ROOT=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI assistant (Google Gemini API). Get a key at https://aistudio.google.com/apikey.
# Never commit a real key. Leave empty to use the template summary only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_S=20
GEMINI_THINKING_LEVEL=low
ASSISTANT_LLM_ENABLED=True
```