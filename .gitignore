# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# Data
data/raw/*
data/interim/*
data/processed/*
data/guidelines/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/guidelines/.gitkeep

# Frontend
node_modules/
dist/
build/

# Jupyter
.ipynb_checkpoints/

# IDE
.idea/

# Generated files
*.log

# Data fetch layer: only the manifest and the hand-entered MIS template are committed
!data/manifest.csv
!data/raw/species/
data/raw/species/*
!data/raw/species/mis_microscopy_manual.csv
*.part
*.egg-info/
.pytest_cache/

# ML pipeline: generated artefacts are rebuilt by `python -m ml.src.pipeline`
ml/outputs/*
!ml/outputs/.gitkeep
